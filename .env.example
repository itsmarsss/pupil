# Copy to .env and fill in what you need. .env is git-ignored; real environment
# variables take precedence over it. Only `pupil control` reads this file.

# --- API keys (all optional) --------------------------------------------------
# Fast tier (Jev): reads every command except stop / confirm / dictation (yes/no and pick-one judgments).
TYPESAFE_API_KEY=
# Claude computer-use agent, for open-ended requests. ANTHROPIC_AUTH_TOKEN also works.
ANTHROPIC_API_KEY=
# Speech-to-text: Cartesia Ink-2 streaming. Without it, on-device Whisper (slower, less accurate).
CARTESIA_API_KEY=
# Apify: live, sourced web research for the agent (hosted MCP and Actor runs, every run capped).
APIFY_TOKEN=

# --- Optional overrides (defaults shown) --------------------------------------
# TYPESAFE_BASE_URL=          # empty = api.typesafe.ai; any compatible gateway works
# PUPIL_GATE_MODEL=jev-1.14.0  # fast-tier model, pinned
# PUPIL_MODEL=claude-sonnet-5-5
# PUPIL_EFFORT=low             # agent effort: fewer, faster steps
# PUPIL_MAX_STEPS=30           # agent step limit for a normal task (Jev picks quick 10 / normal / ongoing)
# PUPIL_MAX_STEPS_ONGOING=300  # "play tetris", "keep doing this": until you say stop, up to this
# PUPIL_MODEL_FAST=claude-sonnet-5-5      # Jev's model tiers for agent tasks (must support computer use)
# PUPIL_MODEL_STANDARD=claude-sonnet-5-5
# PUPIL_MODEL_DEEP=claude-opus-5-5
# PUPIL_DICTATION_MODEL=claude-haiku-4-5-20251001  # formats dictation and "type ..."
# PUPIL_EXTRACT_MODEL=claude-haiku-4-5-20251001    # pulls text, URLs and steps out of commands for Jev
# PUPIL_APIFY_MCP_ENDPOINT=https://mcp.apify.com
# PUPIL_APIFY_TIMEOUT_S=45      # hard per-run timeout (maximum accepted: 120)
# PUPIL_APIFY_MAX_ITEMS=15      # hard item cap (maximum accepted: 50)
# PUPIL_APIFY_MAX_OUTPUT_BYTES=100000
# PUPIL_APIFY_MAX_CHARGE_USD=0.25  # hard charge cap per run (maximum accepted: $1)
# PUPIL_APIFY_TASK_BUDGET_USD=1.00  # hard cap on all runs in one agent task together (maximum accepted: $5)
# PUPIL_APIFY_RESEARCH_ACTOR=apify/rag-web-browser  # can point at the custom Actor
# PUPIL_APIFY_RESEARCH_RETENTION=5
# PUPIL_STT=cartesia          # cartesia | whisper (default: cartesia when CARTESIA_API_KEY is set)
# PUPIL_CARTESIA_MODEL=ink-2
# PUPIL_CARTESIA_END_THRESHOLD=0.5  # 0.05-0.5; higher = ends the turn sooner after you stop talking
# PUPIL_WHISPER=base.en        # speech model name or local path (models/whisper-base.en is used if present)
# PUPIL_MIC=                   # force a microphone by name; empty = follow the macOS default (MacBook mic instead of AirPods)
# PUPIL_AVOID_BLUETOOTH_MIC=1  # 0 = use AirPods' mic when they're the default (puts them in call-quality audio)
# PUPIL_SAVE_AUDIO=1           # 0 = don't keep each command's audio in .logs/audio (local, for debugging)
# PUPIL_VOICE_PROCESSING=0     # 1 = Apple's noise suppression / echo cancellation on the default mic (◉ menu too)
# PUPIL_SPEAK=1                # 0 = don't read Claude's replies aloud (Cartesia Sonic)
# PUPIL_NOTCH=1                # 0 = no notch (the user-facing status at the top of the screen)
# PUPIL_HUD_BAR=0              # 1 = the old status bar at the bottom of the screen (debugging)
# PUPIL_LIP_GATE=on           # on | shadow (log what it would block) | off: listen only while you face the screen and move your lips
# PUPIL_WAKE_WORD=             # e.g. gaze; empty = every utterance is a command
# PUPIL_MODELS_DIR=            # where the tracker finds its model files; default models/
