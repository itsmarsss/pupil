# Pupil settings. Copy to .env and fill in what you need: .env is git-ignored, and real environment
# variables take precedence over it. Voice control (`pupil control`) reads this file.
# Settings named GAZE_* (from before the rename) still work; PUPIL_* wins when both are set.

# === API keys (all optional) ====================================================================
# Jev, the fast tier: reads every command except stop / confirm / dictation (yes/no and pick-one judgments).
TYPESAFE_API_KEY=
# The agent (computer use), plus dictation formatting and text extraction. ANTHROPIC_AUTH_TOKEN also works.
ANTHROPIC_API_KEY=
# Speech in and out: Cartesia Ink-2 (speech-to-text) and Sonic (spoken replies). Without it, on-device
# Whisper hears you (slower, less accurate) and replies are shown, not spoken.
CARTESIA_API_KEY=
# Web research for the agent: Apify's hosted MCP server and Actor runs, every run capped.
APIFY_TOKEN=

# --- Everything below is optional: defaults shown --------------------------------------------------

# === Models ======================================================================================
# TYPESAFE_BASE_URL=                 # empty = api.typesafe.ai; any compatible gateway works
# PUPIL_GATE_MODEL=jev-1.14.0         # Jev's model, pinned
# PUPIL_MODEL=claude-sonnet-5-5        # the agent's default model
# PUPIL_MODEL_FAST=claude-sonnet-5-5   # Jev picks a tier per task (must support computer use):
# PUPIL_MODEL_STANDARD=claude-sonnet-5-5  #   fast: quick questions, games; standard: most tasks;
# PUPIL_MODEL_DEEP=claude-opus-5-5     #   deep: writing, building, several apps
# PUPIL_DICTATION_MODEL=claude-haiku-4-5-20251001  # formats dictation and "type ..."
# PUPIL_EXTRACT_MODEL=claude-haiku-4-5-20251001    # pulls the text, URL or steps out of a command for Jev

# === The agent ===================================================================================
# PUPIL_EFFORT=low                    # fewer, faster steps
# PUPIL_MAX_STEPS=30                  # step limit for a normal task (Jev picks quick 10 / normal / ongoing)
# PUPIL_MAX_STEPS_ONGOING=300         # "play tetris", "keep doing this": until you say stop, up to this
# PUPIL_SPEAK=1                       # 0 = don't read the agent's replies aloud

# === Hearing you =================================================================================
# PUPIL_STT=cartesia                  # cartesia | whisper (default: cartesia when CARTESIA_API_KEY is set)
# PUPIL_CARTESIA_MODEL=ink-2
# PUPIL_CARTESIA_END_THRESHOLD=0.5    # 0.05-0.5; higher = ends your turn sooner after you stop talking
# PUPIL_WHISPER=base.en               # on-device model name or path (models/whisper-base.en if present)
# PUPIL_MIC=                          # a microphone by name; empty = follow the macOS default
# PUPIL_AVOID_BLUETOOTH_MIC=1         # 0 = use AirPods' mic when they're the default (call-quality audio)
# PUPIL_VOICE_PROCESSING=0            # 1 = Apple's noise suppression / echo cancellation (◉ menu too)
# PUPIL_LIP_GATE=on                   # on | shadow (log what it would block) | off: only listen while you
#                                     #   face the screen and move your lips
# PUPIL_WAKE_WORD=                    # e.g. pupil; empty = everything you say can be a command
# PUPIL_DICTATION_FORMAT=1            # 0 = type dictation exactly as heard (no punctuation or symbol fixes)
# PUPIL_SAVE_AUDIO=1                  # 0 = don't keep each command's audio in .logs/audio (local, debugging)

# === Speaking back ===============================================================================
# PUPIL_TTS_MODEL=sonic-3.6
# PUPIL_TTS_VOICE=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4  # a Cartesia voice id (◉ → Agent voice picks one)

# === Web research (Apify) ========================================================================
# PUPIL_APIFY_RESEARCH_ACTOR=apify/rag-web-browser  # or anthonylu/accessible-decision-researcher
# PUPIL_APIFY_MCP_ENDPOINT=https://mcp.apify.com
# PUPIL_APIFY_TIMEOUT_S=45            # per run (at most 120)
# PUPIL_APIFY_MAX_ITEMS=15            # per run (at most 50)
# PUPIL_APIFY_MAX_CHARGE_USD=0.25     # per run (at most $1)
# PUPIL_APIFY_TASK_BUDGET_USD=1.00    # all runs in one agent task together (at most $5)
# PUPIL_APIFY_MAX_OUTPUT_BYTES=100000 # what a run may hand the agent
# PUPIL_APIFY_RESEARCH_RETENTION=5    # finished research runs kept in the dashboard

# === On screen ===================================================================================
# PUPIL_NOTCH=1                       # 0 = no notch (what Pupil is doing, at the top of the screen)
# PUPIL_DISPLAY=heat                  # where you're looking: heat (map) | ring (◉ → Gaze display too)
# PUPIL_HUD_BAR=0                     # 1 = the old status bar at the bottom of the screen (debugging)

# === Apps and models on disk =====================================================================
# PUPIL_BLENDER_PORT=47810            # Blender adapter: the add-on's local port
# PUPIL_MODELS_DIR=                   # the tracker's model files; default models/ in the repo
