# Copy to .env and fill in what you need. .env is git-ignored; real environment
# variables take precedence over it. Only `gaze control` reads this file.

# --- API keys (all optional) --------------------------------------------------
# Fast tier (Jev): yes/no judgments for commands the exact-phrase rules don't cover.
TYPESAFE_API_KEY=
# Claude computer-use agent, for open-ended requests. ANTHROPIC_AUTH_TOKEN also works.
ANTHROPIC_API_KEY=
# Speech-to-text: Cartesia Ink-2 streaming. Without it, on-device Whisper (slower, less accurate).
CARTESIA_API_KEY=
# Apify hosted MCP and Actor runs for live, sourced web research.
GAZE_APIFY_RESEARCH_ACTOR=

# --- Optional overrides (defaults shown) --------------------------------------
# TYPESAFE_BASE_URL=          # empty = api.typesafe.ai; any compatible gateway works
# GAZE_GATE_MODEL=jev-1.14.0  # fast-tier model, pinned
# GAZE_MODEL=claude-sonnet-5-5
# GAZE_EFFORT=low             # agent effort: fewer, faster steps
# GAZE_MAX_STEPS=30           # agent step limit per request
# GAZE_APIFY_MCP_ENDPOINT=https://mcp.apify.com
# GAZE_APIFY_TIMEOUT_S=45      # hard per-run timeout (maximum accepted: 120)
# GAZE_APIFY_MAX_ITEMS=15      # hard item cap (maximum accepted: 50)
# GAZE_APIFY_MAX_OUTPUT_BYTES=100000
# GAZE_APIFY_MAX_CHARGE_USD=0.25  # hard charge cap (maximum accepted: $1)
# GAZE_APIFY_RESEARCH_ACTOR=apify/rag-web-browser  # can point at the custom Actor
# GAZE_APIFY_RESEARCH_RETENTION=5
# GAZE_STT=cartesia          # cartesia | whisper (default: cartesia when CARTESIA_API_KEY is set)
# GAZE_CARTESIA_MODEL=ink-2
# GAZE_CARTESIA_END_THRESHOLD=0.5  # 0.05-0.5; higher = ends the turn sooner after you stop talking
# GAZE_WHISPER=base.en        # speech model name or local path (models/whisper-base.en is used if present)
# GAZE_MIC=                   # force a microphone by name; empty = follow the macOS default (MacBook mic instead of AirPods)
# GAZE_AVOID_BLUETOOTH_MIC=1  # 0 = use AirPods' mic when they're the default (puts them in call-quality audio)
# GAZE_SAVE_AUDIO=1           # 0 = don't keep each command's audio in .logs/audio (local, for debugging)
# GAZE_VOICE_PROCESSING=0     # 1 = Apple's noise suppression / echo cancellation on the default mic (◉ menu too)
# GAZE_SPEAK=1                # 0 = don't read Claude's replies aloud (Cartesia Sonic)
# GAZE_LIP_GATE=on           # on | shadow (log what it would block) | off: listen only while you face the screen and move your lips
# GAZE_WAKE_WORD=             # e.g. gaze; empty = every utterance is a command
# GAZE_MODELS_DIR=            # where the tracker finds its model files; default models/
